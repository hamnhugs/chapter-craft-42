# Chapter Craft sandbox image — builds `chapter-craft-sandbox:latest`.
#
# The runner mounts an AI-authored program at /work/prog and runs exactly one of:
#     bash    /work/prog
#     python3 /work/prog
#     node    /work/prog
#
# It is deliberately minimal at RUN time: no compilers invoked, no runtime package
# installs (the root fs is read-only and offline by default), a non-root default
# user, a bare /work workdir. Every container is started by server.mjs with gVisor
# (--runtime=runsc), --cap-drop ALL, --read-only, --user 65534:65534 and no swap —
# the isolation comes from the runtime flags, not this image.
#
# Third-party libraries are baked in HERE, at build time (which has network + root),
# so approved programs can `import` them even though runtime is sealed. To add more,
# extend the apk line below and rebuild:
#     docker build -f Dockerfile.sandbox -t chapter-craft-sandbox:latest .
#     sudo systemctl restart program-runner   # picks up the new image on next run

# node:20-alpine pins Node 20 (satisfies `node /work/prog`) on a tiny musl base.
FROM node:20-alpine

# Interpreters + a curated, NO-COMPILE Python library set from Alpine's own repos
# (musl-native packages — no build toolchain, no runtime pip). These cover the real
# work programs do: HTTP clients, HTML/XML parsing, async I/O, YAML/date handling,
# and numeric/data work. requests pulls in urllib3/certifi/idna automatically;
# beautifulsoup4 pulls soupsieve. Node 20 already ships a global fetch().
#
# NOTE on scrapy: the crawling FRAMEWORK is intentionally not included — it assumes
# multi-host crawling, cross-run persistence, and minutes-long runs, none of which
# this sandbox provides. Its actual capability (fetch + parse) is covered by
# requests + beautifulsoup4 + lxml below.
RUN apk add --no-cache \
      bash python3 py3-pip \
      py3-requests py3-beautifulsoup4 py3-lxml py3-html5lib \
      py3-aiohttp py3-yaml py3-dateutil \
      py3-numpy py3-pandas \
 && rm -rf /var/cache/apk/* /root/.npm /root/.cache

# A bare, world-traversable workdir. The program is bind-mounted read-only at
# /work/prog by the runner; the container never writes here.
RUN mkdir -p /work && chmod 755 /work
WORKDIR /work

# Default to an unprivileged user. The runner also forces --user 65534:65534 at
# run time, so this is defense in depth rather than the sole control.
USER 65534:65534

# No ENTRYPOINT/CMD on purpose: the runner always supplies the exact argv
# (e.g. ["python3","/work/prog"]).
