# Chapter Craft TTS audio cache — systemd unit. See README.md for the full install.

[Unit]
Description=Chapter Craft TTS audio cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cctts
Group=cctts
WorkingDirectory=/opt/chapter-craft-tts-cache
Environment=TTS_CACHE_CONFIG=/etc/chapter-craft-tts-cache/tts-cache.config.json
ExecStart=/usr/bin/env node server.mjs
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/chapter-craft-tts-cache
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
